# Copiar a .env (nunca se sube al repositorio). Usar una wallet SOLO para despliegue, con el mínimo de POL.
PRIVATE_KEY=
RPC_URL_POLYGON=https://polygon-bor-rpc.publicnode.com
RPC_URL_AMOY=https://polygon-amoy-bor-rpc.publicnode.com
# Opcionales: si se omiten, gobernanza y guardián quedan en la cuenta que despliega.
# En producción la gobernanza debería ser un Safe multisig.
CUENTA_GOBERNANZA=
CUENTA_GUARDIAN_PAUSA=
# Dirección del registro ya desplegado (la completan los scripts de semilla)
DIRECCION_REGISTRO=
# Cuenta a vincular como operadora con VincularCuentaOperadora.s.sol
CUENTA_OPERADORA=
ID_INSTITUCION=
