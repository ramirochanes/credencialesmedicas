# Cabeceras de seguridad (se aplican solo si el hosting permite .htaccess con mod_headers).
# Si cambiás los nodos RPC en config/config.js, actualizá también connect-src.
# auth.privy.io y su RPC son para el ingreso con mail (config.accesoConMail).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://polygon-bor-rpc.publicnode.com https://polygon.drpc.org https://auth.privy.io https://polygon-mainnet.rpc.privy.systems; frame-src https://auth.privy.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType font/woff2 .woff2
</IfModule>
